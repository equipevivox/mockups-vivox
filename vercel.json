{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": { "api/storage.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/portfolio", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/m/:slug", "destination": "/viewer.html" }
  ]
}
